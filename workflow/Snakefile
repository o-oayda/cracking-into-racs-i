rule corner:
  input:
    mid1_artifact=ANALYSIS_ARTIFACTS[MID1_ID]["path"],
    mid1_report=ANALYSIS_VERIFICATION_REPORTS[MID1_ID],
    low3_artifact=ANALYSIS_ARTIFACTS[LOW3_ID]["path"],
    low3_report=ANALYSIS_VERIFICATION_REPORTS[LOW3_ID]
  output:
    'output/figx-corner.pdf'
  params:
    coordinates='equatorial'
  log:
    'log/corner.log'
  shell:
    """
    python scripts/figx-corner.py \
      --mid1-artifact {input.mid1_artifact:q} \
      --low3-artifact {input.low3_artifact:q} \
      --coordinates {params.coordinates:q} \
      --exclude-log10-n-initial-samples \
      --output {output:q} \
      > {log:q} 2>&1
    """

rule posterior_predictive_residuals:
  input:
    paf_dir_path=PAF_DIR_PATH,
    noisemap_path=NOISEMAP_PATH,
    low3_catalogue_path=LOW3_PATH,
    mid1_catalogue_path=MID1_PATH,
    low3_artifact=ANALYSIS_ARTIFACTS[LOW3_ID]["path"],
    low3_report=ANALYSIS_VERIFICATION_REPORTS[LOW3_ID],
    mid1_artifact=ANALYSIS_ARTIFACTS[MID1_ID]["path"],
    mid1_report=ANALYSIS_VERIFICATION_REPORTS[MID1_ID]
  output:
    'output/figx-posterior-predictive-residuals.pdf'
  params:
    backend=POSTERIOR_PREDICTIVE_BACKEND,
    batch_size=POSTERIOR_PREDICTIVE_BATCH_SIZE
  threads:
    1
  resources:
    gpu=1 if POSTERIOR_PREDICTIVE_BACKEND == "jax-cuda" else 0
  log:
    'log/posterior-predictive-residuals.log'
  shell:
    """
    python scripts/figx-posterior-predictive-residuals.py \
      --low3-artifact {input.low3_artifact:q} \
      --mid1-artifact {input.mid1_artifact:q} \
      --low3-catalogue-path {input.low3_catalogue_path:q} \
      --mid1-catalogue-path {input.mid1_catalogue_path:q} \
      --paf-dir-path {input.paf_dir_path:q} \
      --noisemap-path {input.noisemap_path:q} \
      --backend {params.backend:q} \
      --n-workers {threads} \
      --batch-size {params.batch_size} \
      --output {output:q} \
      > {log:q} 2>&1
    """

