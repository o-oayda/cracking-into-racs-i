import shlex

configfile: "workflow/config/artifacts.yaml"

# temp paths
PAF_DIR_PATH = '../dipole-utils/data/paf_temps'
LOW3_PATH = '../../catalogue_data/racs/low3/RACS-low3_sources.fits'
MID1_PATH = '../../catalogue_data/racs/mid1/RACS-mid1_noscale_srl.fits'
NVSS_PATH = '../../catalogue_data/nvss/Full_NVSS_combined_named.dat'
NOISEMAP_PATH = '../../catalogue_data/racs/noisemaps'

LOW3_ID = 'racs_low3_fiducial'
MID1_ID = 'racs_mid1_fiducial'


ANALYSIS_ARTIFACTS = config["artifacts"]
POSTERIOR_PREDICTIVE_BACKEND = config.get(
  "posterior_predictive_backend",
  "numpy",
)
POSTERIOR_PREDICTIVE_BATCH_SIZE = config.get(
  "posterior_predictive_batch_size",
  1,
)
if POSTERIOR_PREDICTIVE_BACKEND not in {"numpy", "jax-cuda"}:
  raise ValueError("posterior_predictive_backend must be numpy or jax-cuda")
if not isinstance(POSTERIOR_PREDICTIVE_BATCH_SIZE, int) or POSTERIOR_PREDICTIVE_BATCH_SIZE < 1:
  raise ValueError("posterior_predictive_batch_size must be a positive integer")
ANALYSIS_VERIFICATION_REPORTS = {
  name: (
    "derived/artifacts/"
    f"{artifact['experiment_id']}.{artifact['sha256']}.verified.json"
  )
  for name, artifact in ANALYSIS_ARTIFACTS.items()
}


def analysis_artifact_path(wildcards):
  artifact = ANALYSIS_ARTIFACTS[wildcards.artifact_name]
  if wildcards.sha256 != artifact["sha256"]:
    raise ValueError(
      f"Checksum wildcard for {wildcards.artifact_name} does not match its config"
    )
  return artifact["path"]


rule all:
  input:
    verification_reports=list(ANALYSIS_VERIFICATION_REPORTS.values()),
    plots = [
      'output/figx-paf-temp.pdf',
      'output/figx-racs-nvss-temp.pdf',
      'output/figx-corner.pdf',
      'output/figx-skymap.png',
      'output/figx-samples.pdf',
      'output/figx-posterior-predictive-residuals.pdf',
      'output/figx-clustering.pdf',
      'output/figx-tempmap.pdf',
      'output/figx-median-residuals.pdf'
    ]


rule verify_racs_analysis_artifact:
  input:
    ANALYSIS_VERIFICATION_REPORTS.values()


rule verify_analysis_artifact:
  input:
    artifact=analysis_artifact_path
  output:
    report="derived/artifacts/{artifact_name}.{sha256}.verified.json"
  params:
    sha256=lambda wildcards: ANALYSIS_ARTIFACTS[wildcards.artifact_name]["sha256"],
    experiment_id=lambda wildcards: ANALYSIS_ARTIFACTS[wildcards.artifact_name]["experiment_id"],
    format_version=lambda wildcards: ANALYSIS_ARTIFACTS[wildcards.artifact_name]["format_version"],
    source_repository=lambda wildcards: ANALYSIS_ARTIFACTS[wildcards.artifact_name]["source_repository"],
    source_commit=lambda wildcards: ANALYSIS_ARTIFACTS[wildcards.artifact_name]["source_commit"],
    require_clean=lambda wildcards: (
      "--require-clean"
      if ANALYSIS_ARTIFACTS[wildcards.artifact_name]["require_clean"]
      else ""
    )
  log:
    'log/verify-{artifact_name}.{sha256}-analysis-artifact.log'
  wildcard_constraints:
    artifact_name="|".join(ANALYSIS_ARTIFACTS),
    sha256="[0-9a-f]{64}"
  shell:
    """
    mkdir -p log
    python scripts/verify-analysis-artifact.py \
      --artifact {input.artifact:q} \
      --expected-sha256 {params.sha256:q} \
      --expected-experiment-id {params.experiment_id:q} \
      --expected-format-version {params.format_version:q} \
      --expected-source-repository {params.source_repository:q} \
      --expected-source-commit {params.source_commit:q} \
      {params.require_clean} \
      --report {output.report:q} \
      > {log:q} 2>&1
    """

rule paf_temp_plot:
  input:
    paf_dir_path=PAF_DIR_PATH,
    catalogue_path=LOW3_PATH
  output:
    plot='output/figx-paf-temp.pdf'
  params:
    observation_day='2024-01-16'
  log:
    'log/plot1.log'
  shell:
    """
    python scripts/figx-paf-temp.py \
      --paf-dir-path {input.paf_dir_path:q} \
      --catalogue-path {input.catalogue_path:q} \
      --observation-day {params.observation_day} \
      > {log:q} 2>&1
    """

