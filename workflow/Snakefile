rule log_bayes_tables:
  input:
    mid1_fiducial_artifact=ANALYSIS_ARTIFACTS[MID1_ID]["path"],
    mid1_fiducial_report=ANALYSIS_VERIFICATION_REPORTS[MID1_ID],
    low3_fiducial_artifact=ANALYSIS_ARTIFACTS[LOW3_ID]["path"],
    low3_fiducial_report=ANALYSIS_VERIFICATION_REPORTS[LOW3_ID],
    comparison_artifacts=log_bayes_comparison_artifacts(),
    comparison_reports=log_bayes_comparison_reports()
  params:
    discard_rounds=LOG_BAYES_DISCARD_ROUNDS,
    uncertainty_significant_figures=LOG_BAYES_UNCERTAINTY_SIGNIFICANT_FIGURES,
    rounding_mode_arg="--use-dp" if LOG_BAYES_USE_DP else "",
    comparison_args=log_bayes_comparison_args(),
    comparison_key_args=log_bayes_comparison_key_args()
  output:
    mid1='output/tablex-log-bayes-mid1.tex',
    low3='output/tablex-log-bayes-low3.tex',
    json='output/log-bayes.json'
  log:
    'log/log-bayes-tables.log'
  shell:
    """
    python scripts/tablex-log-bayes.py \
      --mid1-fiducial-artifact {input.mid1_fiducial_artifact:q} \
      --low3-fiducial-artifact {input.low3_fiducial_artifact:q} \
      --discard-rounds {params.discard_rounds:q} \
      --uncertainty-significant-figures {params.uncertainty_significant_figures:q} \
      {params.rounding_mode_arg} \
      --mid1-output {output.mid1:q} \
      --low3-output {output.low3:q} \
      --json-output {output.json:q} \
      {params.comparison_args} \
      {params.comparison_key_args} \
      > {log:q} 2>&1
    """

rule marginal_json:
