    """
    python scripts/export-marginals.py \
      {params.artifact_args} \
      --coordinates {params.coordinates:q} \
      --output {output:q} \
      > {log:q} 2>&1
    """

rule skymap:
  input:
    mid1_artifact=ANALYSIS_ARTIFACTS[MID1_ID]["path"],
    mid1_report=ANALYSIS_VERIFICATION_REPORTS[MID1_ID],
    low3_artifact=ANALYSIS_ARTIFACTS[LOW3_ID]["path"],
    low3_report=ANALYSIS_VERIFICATION_REPORTS[LOW3_ID],
    mid1_notemp_artifact=ANALYSIS_ARTIFACTS[MID1_NOTEMP_ID]["path"],
    mid1_notemp_report=ANALYSIS_VERIFICATION_REPORTS[MID1_NOTEMP_ID],
    low3_notemp_artifact=ANALYSIS_ARTIFACTS[LOW3_NOTEMP_ID]["path"],
    low3_notemp_report=ANALYSIS_VERIFICATION_REPORTS[LOW3_NOTEMP_ID]
  params:
    coordinates='equatorial',
    quadrants=[2,4],
    rot=[270, 0],
    annotated_longitude_tick=240,
    remove_longitude_ticks=[150, 210],
    O26_point=('galactic', 221, 44, 'O26'),
    B25_point=('equatorial', 165, -10.8, 'B25'),
    O24_point=('galactic', 322, 61, 'O24')
  output:
    'output/figx-skymap.png'
  log:
    'log/skymap.log'
  shell:
    """
    python scripts/figx-skymap.py \
      --mid1-artifact {input.mid1_artifact:q} \
      --low3-artifact {input.low3_artifact:q} \
      --mid1-notemp-artifact {input.mid1_notemp_artifact:q} \
      --low3-notemp-artifact {input.low3_notemp_artifact:q} \
      --plot-notemp \
      --coordinates {params.coordinates:q} \
      --quadrants {params.quadrants:q} \
      --rot {params.rot:q} \
      --annotated-longitude-tick {params.annotated_longitude_tick:q} \
      --remove-longitude-ticks {params.remove_longitude_ticks:q} \
      --point {params.O26_point:q} \
      --point {params.B25_point:q} \
      --point {params.O24_point:q} \
      --output {output:q} \
      > {log:q} 2>&1
    """

rule posterior_predictive_residuals:
  input:
    paf_dir_path=PAF_DIR_PATH,
    noisemap_path=NOISEMAP_PATH,
    low3_catalogue_path=LOW3_PATH,
    mid1_catalogue_path=MID1_PATH,
    low3_artifact=ANALYSIS_ARTIFACTS[LOW3_ID]["path"],
    low3_report=ANALYSIS_VERIFICATION_REPORTS[LOW3_ID],
    mid1_artifact=ANALYSIS_ARTIFACTS[MID1_ID]["path"],
    mid1_report=ANALYSIS_VERIFICATION_REPORTS[MID1_ID]
  output:
    'output/figx-posterior-predictive-residuals.pdf'
  params:
    backend=POSTERIOR_PREDICTIVE_BACKEND,
    batch_size=POSTERIOR_PREDICTIVE_BATCH_SIZE
  threads:
    1
  resources:
    gpu=1 if POSTERIOR_PREDICTIVE_BACKEND == "jax-cuda" else 0
  log:
    'log/posterior-predictive-residuals.log'
  shell:
    """
    python scripts/figx-posterior-predictive-residuals.py \
      --low3-artifact {input.low3_artifact:q} \
      --mid1-artifact {input.mid1_artifact:q} \
      --low3-catalogue-path {input.low3_catalogue_path:q} \
      --mid1-catalogue-path {input.mid1_catalogue_path:q} \
      --paf-dir-path {input.paf_dir_path:q} \
      --noisemap-path {input.noisemap_path:q} \
      --backend {params.backend:q} \
      --n-workers {threads} \
      --batch-size {params.batch_size} \
      --output {output:q} \
      > {log:q} 2>&1
    """

